# RepoMedic environment — copy to .env and fill in. NEVER commit the real file.

# GitHub personal access token (classic, repo scope). Defines everything RepoMedic can touch.
GITHUB_TOKEN=

# Comma-separated list of repos (owner/name) the agent may operate on. Empty = no writes allowed.
REPOMEDIC_ALLOWED_REPOS=

# Port for the custom MCP server
PORT=8815
